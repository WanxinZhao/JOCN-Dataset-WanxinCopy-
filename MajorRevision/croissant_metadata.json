  "@type": "sc:Dataset",
  "name": "JOCN cross-domain dataset revision evaluation bundle",
  "description": "Machine-readable metadata for the processed wireless and optical telemetry tables and the per-run evaluation artefacts used in the major-revision experiments. The optical and wireless measurements come from separate experimental domains and are associated only through explicitly constructed semantic labels; they are not presented as time-synchronised measurements of one physical event.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "1.0-revision",
  "dateModified": "2026-09-02",
