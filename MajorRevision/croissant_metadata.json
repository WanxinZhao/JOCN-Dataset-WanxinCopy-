      "@id": "wireless_real_30s",
      "name": "Processed wireless telemetry",
      "description": "Thirty-second wireless telemetry table containing 5G, Wi-Fi and LiFi measurements plus service and wireless-domain labels.",
      "contentUrl": "../semantic_case_v6/data/wireless_real_30s.csv",
      "encodingFormat": "text/csv",
      "contentSize": "790342 B",
      "sha256": "5e0f7abf24546ae0e9e28b43d17e04b042420470bffc3dfbcb150a265f731ee2"
    },
    {
      "@type": "cr:FileObject",
